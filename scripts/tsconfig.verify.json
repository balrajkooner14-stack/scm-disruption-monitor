{
  // Compiles the pure lib/ modules the verify-*.js harnesses exercise into
  // .verify/. "@/*" resolves for type-checking here; scripts/verify-alias.js
  // maps the emitted "@/lib/x" requires to .verify/x at run time.
  "compilerOptions": {
    "outDir": "../.verify",
    "rootDir": "../lib",
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  "files": [
    "../lib/fetchDisruptions.ts",
    "../lib/tradeFeeds.ts",
    "../lib/fetchTradeNews.ts",
    "../lib/authRouting.ts",
    "../lib/onboardingInsights.ts"
  ]
}
