# Google Gemini API (FREE tier available) — get a key at aistudio.google.com
# Used by: /api/analyze, /api/advisor, /api/chat, /api/scenario,
# /api/event-brief, /api/cost-estimate, /api/import-profile,
# /api/structural-risk-radar
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase — required for auth and cross-device persistence.
# The app still runs fully in guest mode (localStorage) without these, but
# sign-in, profile sync, supplier health, lead-time history, disruption
# history and performance alerts all need them.
# Both are safe to expose client-side (the anon key is protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# No key needed for: GDELT, GDACS, NOAA/NWS, the trade-press RSS feeds,
# Yahoo Finance, USITC HTS, or the OFAC SDN list.
